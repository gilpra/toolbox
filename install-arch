#!/usr/bin/env bash
set -Eeuo pipefail

TARGET=/mnt
VMD_PRESENT=0

# Helpers
die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n==> %s\n' "$*"
}

ok() {
    printf '  [OK] %s\n' "$*"
}

warn() {
    printf '  [WARN] %s\n' "$*" >&2
}

cleanup_secrets() {
    unset ROOT_PASS ROOT_PASS2 USER_PASS USER_PASS2
}

trap cleanup_secrets EXIT

confirm_destructive() {
    local answer

    echo
    echo '================================'
    echo '!!! DESTRUCTIVE INSTALLATION !!!'
    echo '================================'
    echo
    echo 'The following partitions WILL be erased:'
    echo "  EFI  : $EFI_PART"
    echo "  ROOT : $ROOT_PART"
    echo
    echo 'This installer assumes the selected EFI partition belongs'
    echo 'to this Arch installation. Do NOT select a shared Windows'
    echo 'ESP if you need to preserve its files.'
    echo
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS "$DISK"
    echo
    read -r -p 'Continue with formatting? [y/N]: ' answer

    [[ "$answer" =~ ^[Yy]$ ]] ||
        die 'Aborted. No filesystem was erased.'
}

# Preflight
[[ $EUID -eq 0 ]] ||
    die 'Run this installer as root from the Arch ISO.'

[[ -d /sys/firmware/efi/efivars ]] ||
    die 'The Arch ISO was not booted in UEFI mode.'

mountpoint -q /sys/firmware/efi/efivars ||
    die 'EFI variables are not mounted. Boot the ISO in UEFI mode.'

# Time and network
info 'Synchronizing system clock'
timedatectl set-ntp true

if timedatectl show -p NTPSynchronized --value | grep -q '^yes$'; then
    ok 'Clock synchronized'
else
    warn 'NTP synchronization was not confirmed; continuing.'
fi

info 'Checking network'
curl -fsS --max-time 10 https://archlinux.org >/dev/null ||
    die 'No working Internet connection.'
ok 'Internet connection works'

if command -v reflector >/dev/null 2>&1; then
    info 'Refreshing mirrorlist with reflector'

    reflector \
        --latest 10 \
        --protocol https \
        --country Indonesia,Singapore \
        --completion-percent 100 \
        --sort rate \
        --save /etc/pacman.d/mirrorlist ||
        warn 'reflector failed; keeping the existing mirrorlist.'
fi

# Input system configuration
info 'System configuration'

read -r -p '  Hostname: ' SYS_HOSTNAME
[[ "$SYS_HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] ||
    die "Invalid hostname '$SYS_HOSTNAME'."

read -r -p '  Timezone (example: Asia/Jakarta): ' TIMEZONE
[[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] ||
    die "Invalid timezone '$TIMEZONE'."

read -r -p '  Username: ' USERNAME
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] ||
    die "Invalid username '$USERNAME'."

# Partition setup
info 'Partition setup'

read -r -p '  Target disk (example: /dev/nvme0n1): ' DISK
[[ -b "$DISK" ]] ||
    die "Disk '$DISK' does not exist."

[[ "$(lsblk -dn -o TYPE "$DISK" | tr -d '[:space:]')" == 'disk' ]] ||
    die "'$DISK' is not a whole disk."

if lsblk -nrpo MOUNTPOINTS "$DISK" | grep -q '[^[:space:]]'; then
    die "One or more partitions on '$DISK' are still mounted."
fi

echo
lsblk -o NAME,SIZE,TYPE,FSTYPE,FSAVAIL,FSUSE%,MOUNTPOINTS "$DISK"
echo

cfdisk "$DISK"
partprobe "$DISK"

[[ "$(lsblk -dn -o PTTYPE "$DISK")" == "gpt" ]] ||
    die "'$DISK' is not GPT."

read -r -p '  EFI System Partition: ' EFI_PART
read -r -p '  Linux root partition: ' ROOT_PART

[[ -b "$EFI_PART" ]] ||
    die "EFI partition '$EFI_PART' does not exist."

[[ -b "$ROOT_PART" ]] ||
    die "Root partition '$ROOT_PART' does not exist."

[[ "$EFI_PART" != "$ROOT_PART" ]] ||
    die 'EFI and root partitions must be different.'

DISK_NAME="$(basename "$DISK")"

for part in "$EFI_PART" "$ROOT_PART"; do
    [[ "$(lsblk -no PKNAME "$part")" == "$DISK_NAME" ]] ||
        die "'$part' is not a partition of '$DISK'."
done

EFI_TYPE="$(lsblk -no PARTTYPE "$EFI_PART")"

[[ "${EFI_TYPE^^}" == "C12A7328-F81F-11D2-BA4B-00A0C93EC93B" ]] ||
    die "'$EFI_PART' is not an EFI System Partition."

# VMD detection
if lsmod | grep '^vmd\b' >/dev/null; then
    VMD_PRESENT=1
    echo
    echo 'Intel VMD detected.'
fi

confirm_destructive

# Filesystems
info 'Formatting filesystems'

wipefs -af "$EFI_PART"
wipefs -af "$ROOT_PART"

mkfs.fat -F32 -n EFI "$EFI_PART"
mkfs.btrfs -f -L ArchRoot "$ROOT_PART"

# Btrfs subvolumes
info 'Creating Btrfs subvolumes'

mount "$ROOT_PART" "$TARGET"

for sv in @ @home @cache @log; do
    btrfs subvolume create "$TARGET/$sv"
done

umount "$TARGET"

# Btrfs mounts
info 'Mounting Btrfs subvolumes'

BTRFS_OPTS='noatime,compress=zstd:1,ssd,space_cache=v2,discard=async'

mount -o "$BTRFS_OPTS,subvol=@" "$ROOT_PART" "$TARGET"

mkdir -p \
    "$TARGET/home" \
    "$TARGET/var/cache" \
    "$TARGET/var/log" \
    "$TARGET/boot/efi"

mount -o "$BTRFS_OPTS,subvol=@home" "$ROOT_PART" "$TARGET/home"
mount -o "$BTRFS_OPTS,subvol=@cache" "$ROOT_PART" "$TARGET/var/cache"
mount -o "$BTRFS_OPTS,subvol=@log" "$ROOT_PART" "$TARGET/var/log"
mount "$EFI_PART" "$TARGET/boot/efi"

# Base installation
info 'Installing base system'

pacstrap -K "$TARGET" \
    base \
    base-devel \
    linux-zen \
    linux-firmware \
    intel-ucode \
    btrfs-progs \
    mkinitcpio \
    sudo \
    git \
    neovim \
    networkmanager \
    iwd \
    pipewire \
    pipewire-audio \
    pipewire-alsa \
    pipewire-pulse \
    wireplumber \
    sof-firmware \
    grub \
    efibootmgr \
    zram-generator \
    power-profiles-daemon \
    thermald

# fstab
info 'Generating fstab'

genfstab -U "$TARGET" > "$TARGET/etc/fstab"

# Chroot configuration
info 'Configuring installed system'

arch-chroot "$TARGET" /bin/bash -s -- \
    "$TIMEZONE" \
    "$SYS_HOSTNAME" \
    "$USERNAME" \
    "$VMD_PRESENT" <<'CHROOT'
set -Eeuo pipefail

TIMEZONE="$1"
SYS_HOSTNAME="$2"
USERNAME="$3"
VMD_PRESENT="$4"

# Timezone
ln -sf "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime
hwclock --systohc

# Locale
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo 'LANG=en_US.UTF-8' > /etc/locale.conf

# Hostname
printf '%s\n' "$SYS_HOSTNAME" > /etc/hostname

cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${SYS_HOSTNAME}.localdomain ${SYS_HOSTNAME}
HOSTS

# Console keyboard
echo 'KEYMAP=us' > /etc/vconsole.conf

# User
if ! id "$USERNAME" >/dev/null 2>&1; then
    useradd -m -G wheel -s /bin/bash "$USERNAME"
fi

# sudo
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/99-wheel
chmod 440 /etc/sudoers.d/99-wheel
visudo -cf /etc/sudoers.d/99-wheel

# NetworkManager: use iwd as the Wi-Fi backend
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/wifi_backend.conf <<'IWD'
[device]
wifi.backend=iwd
IWD

# Services
systemctl enable NetworkManager.service
systemctl enable systemd-timesyncd.service
systemctl enable power-profiles-daemon.service
systemctl enable thermald.service

# zram
cat > /etc/systemd/zram-generator.conf <<'ZRAM'
[zram0]
zram-size = ram
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
ZRAM

# Disable zswap so zram is the swap-compression layer.
if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub; then
    sed -i \
        's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/GRUB_CMDLINE_LINUX_DEFAULT="\1 zswap.enabled=0"/' \
        /etc/default/grub
else
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="zswap.enabled=0"' >> /etc/default/grub
fi

mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-zram-swappiness.conf <<'SYSCTL'
vm.swappiness = 150
SYSCTL

# VMD
if [[ "$VMD_PRESENT" -eq 1 ]]; then
    mkdir -p /etc/mkinitcpio.conf.d

    cat > /etc/mkinitcpio.conf.d/10-vmd.conf <<'VMD'
MODULES+=(vmd)
VMD
fi

# Initramfs
mkinitcpio -P

# GRUB
grub-install \
    --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --bootloader-id=GRUB

grub-install \
    --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --bootloader-id=GRUB \
    --removable

grub-mkconfig -o /boot/grub/grub.cfg
CHROOT

# Passwords
info 'Setting account passwords'

while true; do
    read -r -s -p '  Root password: ' ROOT_PASS
    echo
    read -r -s -p '  Confirm root password: ' ROOT_PASS2
    echo

    [[ -n "$ROOT_PASS" && "$ROOT_PASS" == "$ROOT_PASS2" ]] && break
    echo '  [WARN] Root passwords did not match.'
done

while true; do
    read -r -s -p "  Password for $USERNAME: " USER_PASS
    echo
    read -r -s -p "  Confirm password for $USERNAME: " USER_PASS2
    echo

    [[ -n "$USER_PASS" && "$USER_PASS" == "$USER_PASS2" ]] && break
    echo '  [WARN] User passwords did not match.'
done

printf 'root:%s\n' "$ROOT_PASS" |
    arch-chroot "$TARGET" chpasswd

printf '%s:%s\n' "$USERNAME" "$USER_PASS" |
    arch-chroot "$TARGET" chpasswd

cleanup_secrets

# Post-install verification
info 'Verifying installation'
VERIFY_FAILED=0

if arch-chroot "$TARGET" findmnt --verify >/dev/null 2>&1; then
    ok 'fstab verification passed'
else
    warn 'fstab verification failed'
    VERIFY_FAILED=1
fi

for file in \
    "$TARGET/boot/efi/EFI/GRUB/grubx64.efi" \
    "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI" \
    "$TARGET/boot/grub/grub.cfg" \
    "$TARGET/boot/vmlinuz-linux-zen" \
    "$TARGET/boot/initramfs-linux-zen.img" \
    "$TARGET/boot/intel-ucode.img"; do

    if [[ -f "$file" ]]; then
        ok "Found: ${file#"$TARGET"}"
    else
        warn "Missing: ${file#"$TARGET"}"
        VERIFY_FAILED=1
    fi
done

if arch-chroot "$TARGET" id "$USERNAME" >/dev/null 2>&1; then
    ok "User '$USERNAME' exists"
else
    warn "User '$USERNAME' is missing"
    VERIFY_FAILED=1
fi

echo

if ((VERIFY_FAILED == 0)); then
    ok 'Installation checks passed.'
    echo
    echo 'Installation complete.'
    echo 'Review /mnt/etc/fstab before rebooting if desired.'
    echo 'The selected EFI and root partitions were formatted.'

    if umount -R "$TARGET"; then
        ok 'Target filesystems unmounted.'
    else
        warn "Could not completely unmount $TARGET."
    fi
else
    warn 'One or more installation checks failed.'
    echo 'The target has been left mounted for inspection.'
    echo 'Do NOT reboot until the failures are understood.'
    exit 1
fi
